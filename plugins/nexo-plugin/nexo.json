{
  "env": {
    "useLombok": false,
    "generateMappers": true,
    "dtoSuffix": "DTO",
    "javaVersion": 17
  },
  "entities": [
    {
      "name": "User",
      "tableName": "users",
      "fields": [
        {
          "name": "username",
          "type": "STRING",
          "persistence": {
            "columnName": "username",
            "nullable": false,
            "unique": true,
            "length": 100
          },
          "validation": {
            "notNull": true,
            "notEmpty": true,
            "size": { "min": 3, "max": 50 }
          }
        },
        {
          "name": "email",
          "type": "STRING",
          "persistence": {
            "columnName": "email",
            "nullable": false,
            "unique": true,
            "length": 255
          },
          "validation": {
            "notNull": true,
            "email": true
          }
        },
        {
          "name": "age",
          "type": "INTEGER",
          "persistence": {
            "columnName": "age",
            "nullable": true
          },
          "validation": {
            "min": 0,
            "max": 150
          }
        },
        {
          "name": "createdAt",
          "type": "LOCAL_DATE_TIME",
          "persistence": {
            "columnName": "created_at",
            "nullable": false,
            "updatable": false
          }
        }
      ],
      "indexes": [
        {
          "columnList": ["email"],
          "unique": true
        },
        {
          "columnList": ["email"]
        }
      ]
    },
    {
      "name": "Order",
      "tableName": "orders",
      "fields": [
        {
          "name": "orderNumber",
          "type": "STRING",
          "persistence": {
            "columnName": "order_number",
            "nullable": false,
            "unique": true,
            "length": 50
          },
          "validation": {
            "notNull": true,
            "notEmpty": true
          }
        },
        {
          "name": "totalAmount",
          "type": "DECIMAL",
          "persistence": {
            "columnName": "total_amount",
            "nullable": false,
            "precision": 10,
            "scale": 2
          },
          "validation": {
            "notNull": true,
            "min": 0
          }
        },
        {
          "name": "status",
          "type": "STRING",
          "persistence": {
            "columnName": "status",
            "nullable": false,
            "length": 20
          }
        }
      ]
    }
  ],
  "relations": [
    {
      "type": "ONE_TO_MANY",
      "bidirectional": true,
      "from": {
        "entity": "User",
        "name": "orders",
        "cascade": ["PERSIST", "MERGE"],
        "orphanRemoval": true
      },
      "to": {
        "entity": "Order",
        "name": "user"
      }
    },
    {
      "type": "MANY_TO_ONE",
      "bidirectional": true,
      "from": {
        "entity": "Order",
        "name": "user",
        "cascade": ["PERSIST", "MERGE"]
      },
      "to": {
        "entity": "User",
        "name": "orders"
      }
    }
  ],
  "enums": [
    {
      "name": "OrderStatus",
      "values": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"]
    }
  ]
}
